<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>user-home🐙</title>
     <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=add" />
<link href="https://fonts.googleapis.com/css2?family=WDXL+Lubrifont+TC&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=account_circle" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=arrow_upward" />
    <style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    body {
        background-color: black;
        height: 100vh;
    }
.material-symbols-outlined {
  font-variation-settings:
  'FILL' 0,
  'wght' 400,
  'GRAD' 0,
  'opsz' 24
}

textarea.custom-input {
  border: none;
  /* background-color: rgba(255, 255, 255, 0.1); semi-transparent white */
  background-color: transparent;
  padding: 10px 15px;
  border-top-left-radius: 8px;
  color: white; /* or adjust to match your background */
  outline: none;
  font-size: 16px;
  box-sizing: border-box;
  
}

/* Optional: Add a subtle shadow for depth */
/* input.custom-input:focus { */
  /* box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.2); */
/* } */

.image-holder-mobile-holder {
  background-color: orangered; border: 2px solid orangered; height: 70px; width: 70px; border-radius: 50%; display: flex; justify-content: center; align-items: center;
}

@media screen and (max-width: 960px)  {
  .image-holder-mobile-holder {
    height: 50px;
    width: 50px;
  }
}

    </style>
</head>
<body>
   
<div style="height: 15%;  width: 100%; display: flex; justify-content: center; align-items: center;">

    <div style="display: flex; justify-content: start; align-items: center; height: 100%; width: 50%;">
    <div style="height: 100%; width: 100%; display: flex; justify-content: start; align-items: center;"><h2 style="color: orangered; padding-left: 10px; font-size: 40px;  font-family: WDXL Lubrifont TC, sans-serif;
  font-weight: 400;
  font-style: normal;">Welcome, <%= username %></h2></div>
    </div>

    <div style=" height: 100%; width: 50%; display: flex; justify-content: end; align-items: center;"> 
        <!-- logout button container img -->

         <div class="image-holder-mobile-holder">
    <% if (avatar) { %>
  <!-- HTML to render if condition is true -->
   <img  style="height: 100%; width: 100%; border-radius: 50%;" src= "<%= avatar %>" alt="avatar">
   
<% } else { %>
  <!-- HTML to render if condition is false -->
 <span class="material-symbols-outlined" style="width: 100%; height: 100%; font-size: 60px;">
account_circle
</span>
<% } %>
         </div>


         <div style="width: 20%; height: 50%; background-color: orangered; border: 1px solid orangered; cursor: pointer; margin: 5px; display: flex; justify-content: center; align-items: center; border-radius: 10px;">
        <form action="/auth/logout" method="POST">
  <button type="submit" style="color: black; offset: none; background: transparent; border: none;"><p style=" font-family: WDXL Lubrifont TC, sans-serif;
  font-weight: 400; font-size: 20px; text-decoration: dashed; cursor: pointer;">logout</p></button>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>
         </div>

    </div>

</div>

<div style="height: 80%; width: 100%; display: flex; flex-direction: column; justify-content: end; align-items: center;">

    <div style="height: 120px; width: 80%; background-color: rgba(255, 255, 255, 0.1); border-radius: 10px; border:1px solid orangered; display: flex; flex-direction: column; justify-content: center; align-items: center;">
      <div style= "width: 100%; height: 70px;">
        <textarea type="text" placeholder="  Type In The Description" class="descInput custom-input" style="width: 90%; height: 100%;" cols="50" rows="50"></textarea>
        <!-- <div style="width: ;"></div> -->
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" class="wapper">
      </div>

      <div style="width: 100%; height: 50px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; display: flex; justify-content: end; align-items: center;">

        <!-- <div style="height: 40px; width: 40px; border-radius: 50%; background-color: white; margin: 5px; display: flex; justify-content: center; align-items: center;">
         <span class="material-symbols-outlined">
add
</span>
        </div> -->

         <div style="height: 40px; width: 40px; border-radius: 50%; background-color: white; margin: 5px; display: flex; justify-content: center; align-items: center; cursor: pointer;" class="descBtn">
          <span class="material-symbols-outlined">
arrow_upward
</span>
         </div>

      </div>
    </div>

</div>



<script type="module" src="/js/js.js"></script>
</body>
</html>